# Copy to .env for local development. In production set these in your host's dashboard.
PORT=5000
NODE_ENV=production

# Long random string - REQUIRED in production
JWT_SECRET=change-me-to-a-long-random-string

# Hosted Postgres connection string (Neon / Render / Supabase). If unset, falls back to local SQLite.
DATABASE_URL=

MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
BIBLE_DB_PATH=./data/bible.db

