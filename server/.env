# Environment Configuration
PORT=5000
NODE_ENV=development

# Database - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scripturelive
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Bible Database
BIBLE_DB_PATH=./data/bible.db

